# Puerto donde correrá el API Gateway
PORT=3600

# URL base del servicio de autenticación (Auth Service)
AUTH_SERVICE_BASE_URL=http://IP_DEL_SERVICIO:PUERTO

# URL base del servicio de vehículos (Vehicle Service)
VEHICLE_SERVICE_BASE_URL=http://IP_DEL_SERVICIO:PUERTO

# URL base del servicio de clientes (Client Service)
CLIENT_SERVICE_BASE_URL=http://IP_DEL_SERVICIO:PUERTO

# URL base del servicio de subida de archivos (Upload Files Service)
UPLOAD_FILES_SERVICE_BASE_URL=http://IP_DEL_SERVICIO:PUERTO

# URL base del servicio de recepción (Reception Service)
RECEPTION_SERVICE_BASE_URL=http://IP_DEL_SERVICIO:PUERTO

# URL base del API Gateway (usada para construir URLs completas en las respuestas)
API_GATEWAY_BASE_URL=http://localhost:3600

# API Key que el gateway envía automáticamente a los microservicios en cada solicitud
# (Usado en el interceptor para identificar al gateway)
API_KEY=my-secret-api-key-12345

# API Key que debe enviar el frontend/Postman en el header 'x-api-key'
# para que el ApiKeyGuard acepte la solicitud entrante
API_KEY_FRONT=frontend-secret-api-key-67890

# Credenciales para proteger la documentación de Swagger UI
SWAGGER_USER=admin
SWAGGER_PASS=admin123
