<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Helvetica Neue', Arial, sans-serif; color: #1f2937; padding: 40px; }
    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid #2563eb; padding-bottom: 20px; margin-bottom: 30px; }
    .header h1 { font-size: 28px; color: #2563eb; font-weight: 700; }
    .header .invoice-number { font-size: 14px; color: #6b7280; }
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; }
    .info-box { background: #f9fafb; border-radius: 8px; padding: 16px; }
    .info-box h3 { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #6b7280; margin-bottom: 8px; }
    .info-box p { font-size: 14px; color: #1f2937; line-height: 1.6; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    th { background: #2563eb; color: white; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; }
    td { padding: 12px 16px; border-bottom: 1px solid #e5e7eb; font-size: 14px; }
    td:last-child, th:last-child { text-align: right; }
    tbody tr:nth-child(even) { background: #f9fafb; }
    .totals { margin-left: auto; width: 300px; }
    .totals table { margin-bottom: 0; }
    .totals td { border: none; padding: 8px 16px; }
    .totals td:last-child { text-align: right; font-weight: 600; }
    .totals .grand-total td { font-size: 18px; font-weight: 700; color: #2563eb; border-top: 2px solid #2563eb; padding-top: 12px; }
    .footer { margin-top: 40px; text-align: center; color: #9ca3af; font-size: 12px; border-top: 1px solid #e5e7eb; padding-top: 20px; }
    .badge { display: inline-block; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600; }
    .badge-pending { background: #fef3c7; color: #d97706; }
    .badge-paid { background: #d1fae5; color: #059669; }
  </style>
</head>
<body>
  <div class="header">
    <div>
      <h1>FACTURA</h1>
      <p class="invoice-number">N° {{invoice_number}}</p>
    </div>
    <div style="text-align: right;">
      <p style="font-size: 14px; color: #6b7280;">Fecha: {{date}}</p>
      <span class="badge badge-{{#if (eq statusName 'Pagado')}}paid{{else}}pending{{/if}}">{{statusName}}</span>
    </div>
  </div>

  <div class="info-grid">
    <div class="info-box">
      <h3>Cliente</h3>
      <p><strong>{{client.name}}</strong></p>
      <p>Documento: {{client.document}}</p>
      {{#if client.address}}<p>Dirección: {{client.address}}</p>{{/if}}
      {{#if client.phone}}<p>Teléfono: {{client.phone}}</p>{{/if}}
      {{#if client.email}}<p>Email: {{client.email}}</p>{{/if}}
    </div>
    <div class="info-box">
      <h3>Vehículo</h3>
      {{#if vehicle}}
      <p><strong>{{vehicle.placa}}</strong></p>
      <p>{{vehicle.marca.nombre}} {{vehicle.linea.nombre}} {{vehicle.modelo}}</p>
      {{else}}
      <p>Sin datos de vehículo</p>
      {{/if}}
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Concepto</th>
        <th style="text-align: center;">Cant.</th>
        <th style="text-align: right;">P. Unitario</th>
        <th style="text-align: right;">Total</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td>{{concept}}</td>
        <td style="text-align: center;">{{quantity}}</td>
        <td style="text-align: right;">$ {{formatNumber unitPrice}}</td>
        <td style="text-align: right;">$ {{formatNumber total}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="totals">
    <table>
      <tr><td>Subtotal</td><td>$ {{formatNumber subtotal}}</td></tr>
      <tr><td>IVA (0%)</td><td>$ {{formatNumber tax}}</td></tr>
      <tr class="grand-total"><td>Total</td><td>$ {{formatNumber total}}</td></tr>
    </table>
  </div>

  {{#if observations}}
  <div style="margin-top: 20px; padding: 12px; background: #f9fafb; border-radius: 8px;">
    <p style="font-size: 12px; color: #6b7280; margin-bottom: 4px;">Observaciones</p>
    <p style="font-size: 14px;">{{observations}}</p>
  </div>
  {{/if}}

  <div class="footer">
    <p>CDA SYSTEM - Centro de Diagnóstico Automotriz</p>
    <p>Documento generado electrónicamente</p>
  </div>
</body>
</html>